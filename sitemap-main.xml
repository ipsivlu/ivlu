---
layout: null
permalink: /sitemap-main.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">{% assign pages = site.html_pages | where_exp: "page", "page.sitemap != false" %}{% for page in pages %}{% unless page.url contains "404" or page.url contains "gracias" or page.url contains "thanks" or page.url contains ".xml" %}
<url>
<loc>{{ site.url }}{{ page.url | remove: "index.html" | xml_escape }}</loc>
<lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
{%- if page.ref -%}
  {%- assign par = site.html_pages | where: "ref", page.ref | where_exp: "d", "d.url != page.url" | first -%}
  {%- if par -%}
{%- if page.lang == 'en' -%}{%- assign u_es = par.url -%}{%- assign u_en = page.url -%}{%- else -%}{%- assign u_es = page.url -%}{%- assign u_en = par.url -%}{%- endif %}
<xhtml:link rel="alternate" hreflang="es" href="{{ site.url }}{{ u_es | xml_escape }}"/>
<xhtml:link rel="alternate" hreflang="en" href="{{ site.url }}{{ u_en | xml_escape }}"/>
<xhtml:link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ u_es | xml_escape }}"/>
  {%- endif -%}
{%- endif %}
<changefreq>{% if page.url == "/" %}daily{% else %}weekly{% endif %}</changefreq>
<priority>{% if page.url == "/" %}1.0{% elsif page.url contains "/es/" or page.url contains "/en/" %}0.9{% else %}0.8{% endif %}</priority>
</url>{% endunless %}{% endfor %}
</urlset>