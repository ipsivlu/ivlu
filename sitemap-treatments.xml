---
layout: null
permalink: /sitemap-treatments.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml"
        xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
{%- assign treatments = "" | split: "" -%}
{%- assign treatments = treatments | concat: site.servicios_es -%}
{%- assign treatments = treatments | concat: site.servicios_en -%}
{%- assign treatments = treatments | concat: site.tecnologia_es -%}
{%- assign treatments = treatments | concat: site.tecnologia_en -%}

{%- for treatment in treatments -%}
  <url>
    <loc>{{ site.url }}{{ treatment.url | xml_escape }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    {%- if treatment.ref -%}
      {%- assign par = treatments | where: "ref", treatment.ref | where_exp: "d", "d.url != treatment.url" | first -%}
      {%- if par -%}
        {%- if treatment.lang == 'en' -%}{%- assign u_es = par.url -%}{%- assign u_en = treatment.url -%}{%- else -%}{%- assign u_es = treatment.url -%}{%- assign u_en = par.url -%}{%- endif %}
    <xhtml:link rel="alternate" hreflang="es" href="{{ site.url }}{{ u_es | xml_escape }}"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.url }}{{ u_en | xml_escape }}"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ u_es | xml_escape }}"/>
      {%- endif -%}
    {%- endif %}
    {%- if treatment.hero %}
    <image:image>
      <image:loc>{{ site.url }}{{ treatment.hero | xml_escape }}</image:loc>
      <image:title>{{ treatment.title | xml_escape }}</image:title>
      {%- if treatment.alt %}
      <image:caption>{{ treatment.alt | xml_escape }}</image:caption>
      {%- endif %}
    </image:image>
    {%- endif %}
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
{%- endfor -%}
</urlset>